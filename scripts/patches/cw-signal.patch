@@ -2592,6 +2660,23 @@ static void usr1_handler( int signal, siginfo_t *siginfo, void *_sigcontext )
 
 
 #if defined(__APPLE__) || defined(__linux__)
+#ifdef __APPLE__
+/* CW Hack 24265 (ported from CrossOver's LGPL-2.1 Wine fork,
+ * dlls/ntdll/unix/signal_x86_64.c). On Apple Silicon under Rosetta the mxcsr
+ * value carried in the syscall-entry sigcontext can be stale/corrupt and
+ * Rosetta ignores direct writes to it, so sigsys_handler stashes the correct
+ * value in amd64_thread_data()->mxcsr and redirects RIP here; this thunk
+ * reloads it before falling into the dispatcher prolog. The thread-data layout
+ * (teb at %gs:0x30, mxcsr at +0x33c) is identical in our engine, so the asm
+ * ports verbatim. */
+extern void __restore_mxcsr_thunk(void);
+__ASM_GLOBAL_FUNC( __restore_mxcsr_thunk,
+                   "pushq %rcx\n\t"
+                   "movq %gs:0x30,%rcx\n\t"
+                   "ldmxcsr 0x33c(%rcx)\n\t"  /* amd64_thread_data()->mxcsr */
+                   "popq %rcx\n\t"
+                   "jmp " __ASM_LOCAL_LABEL("__wine_syscall_dispatcher_prolog_end") )
+#endif
 /**********************************************************************
  *		sigsys_handler
  *
@@ -2629,6 +2714,28 @@ static void sigsys_handler( int signal, siginfo_t *siginfo, void *_sigcontext )
         frame->restore_flags |= CONTEXT_CONTROL;
     }
     RIP_sig(sigcontext) = (ULONG64)__wine_syscall_dispatcher_prolog_end_ptr;
+#ifdef __APPLE__
+    /* CW Hack 24265 (ported from CrossOver's LGPL-2.1 Wine fork). Under Rosetta
+     * the mxcsr in the sigcontext can be wrong on syscall entry; correct it, and
+     * because Rosetta on M-series will reload the stale sigcontext value anyway,
+     * stash the right value in amd64_thread_data()->mxcsr and redirect into the
+     * thunk above, which reloads it before entering the dispatcher prolog. */
+    if (is_rosetta2 && FPU_sig(sigcontext))
+    {
+        XMM_SAVE_AREA32 fpu;
+        unsigned int direct_mxcsr;
+
+        __asm__ volatile( "stmxcsr %0" : "=m" (direct_mxcsr) );
+        memcpy( &fpu, FPU_sig(sigcontext), sizeof(fpu) );
+        if (direct_mxcsr != fpu.MxCsr)
+        {
+            fpu.MxCsr = direct_mxcsr;
+            memcpy( FPU_sig(sigcontext), &fpu, sizeof(fpu) );
+            amd64_thread_data( data )->mxcsr = direct_mxcsr;
+            RIP_sig(sigcontext) = (ULONG64)__restore_mxcsr_thunk;
+        }
+    }
+#endif
 }
 #endif
 
